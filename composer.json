{
    "name": "innis/nostr-demo",
    "description": "Demo project showcasing nostr-core, nostr-client, and nostr-relay working together",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "John Innis",
            "email": "john@innis.xyz",
            "homepage": "https://www.innis.xyz/"
        }
    ],
    "require": {
        "php": "^8.4",
        "amphp/http-server": "^3.0",
        "innis/nostr-client": "^0.8",
        "innis/nostr-core": "^0.8",
        "innis/nostr-relay": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "ext-ffi": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "innis/coding-standards": "^0.1",
        "phpstan/phpstan": "~2.2.6",
        "rector/rector": "~2.5.9"
    },
    "scripts": {
        "test": [
            "@analyse"
        ],
        "analyse": "phpstan analyse",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "check-rector": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
